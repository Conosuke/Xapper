<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework />
    <!-- net462 하나가 .NET Framework 4.0~4.8.1 앱을 모두 덮는다 (4.x 는 CLR 4 위의 제자리 업그레이드). -->
    <TargetFrameworks>net462;net6.0-windows;net7.0-windows;net8.0-windows;net9.0-windows</TargetFrameworks>
    <UseWPF>true</UseWPF>
    <!-- 라이브러리는 기본적으로 NuGet 어셈블리를 bin 에 복사하지 않는다. 주입 페이로드에 MinHook.NET.dll 을
         담으려면 각 TFM bin 에 실제로 놓여야 하므로 복사를 켠다. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Xapper.Protocol\Xapper.Protocol.csproj" />
  </ItemGroup>

  <!-- 대상 프로세스 안에서 user32 를 짧게 후킹해 실제 커서 없이 클릭·드래그하기 위한 인라인 후킹 라이브러리.
       modern TFM 에서 의존성 없는 단일 DLL 이며, 주입 페이로드에 함께 추출된다. -->
  <ItemGroup>
    <PackageReference Include="MinHook.NET" Version="1.1.2" />
  </ItemGroup>

  <!-- 오래된 TFM 에서 C# 12 를 쓰기 위한 컴파일러 폴리필. 소스로만 생성되어 런타임 의존성이 없다. -->
  <ItemGroup>
    <PackageReference Include="PolySharp" Version="1.15.0" PrivateAssets="all" />
  </ItemGroup>

  <!-- .NET Framework 개발자 팩 없이도 빌드되도록 참조 어셈블리를 패키지로 받는다. -->
  <ItemGroup Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <!-- 내부 헬퍼를 공개 API로 올리지 않고 테스트에서 직접 검증하기 위함 -->
  <ItemGroup>
    <InternalsVisibleTo Include="Xapper.Tests" />
  </ItemGroup>

</Project>
