<Project Sdk="Microsoft.NET.Sdk">

  <!-- This app's E2E cases in one console project: running this project with `dotnet run` runs them all,
       and giving it case ids as extra arguments, for example C01 C02, runs only those.
       TargetFramework follows the app's .NET version without -windows (net8.0-windows -> net8.0). For an app
       older than .NET 8 or on .NET Framework keep net8.0, the lowest the MCP client supports - this project
       never references the app, it only talks to it through MCP. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>E2E</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="1.2.0" />
  </ItemGroup>

  <!-- Bakes this folder's path into the program, so cases.json, e2e.env and results/ are found wherever
       the run is started from. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>E2EFolder</_Parameter1>
      <_Parameter2>$(MSBuildProjectDirectory)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
