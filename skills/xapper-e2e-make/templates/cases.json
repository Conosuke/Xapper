{
  // This app's E2E cases. Each case is a file in Cases/ whose name starts with its id
  // (Cases/C01-main-window-opens.cs) holding a static class marked [Case("C01")] with
  // `public static Task Run(Session x)`. An id is never reused, not even after its case is deleted.
  //
  // Every case names a setup - a class in Setups/ marked [Setup("name")] that launches the app and does
  // what the case needs first. The runner runs a setup once and then every case that names it in the
  // same running app; it sets up again after a failed case, and before a case marked "fresh".
  //
  // {
  //   "id": "C01",
  //   "feature": "start-up",                   // the feature it covers; used to pick cases for "test the X feature"
  //   "title": "The main window opens ready to use",
  //   "file": "C01-main-window-opens.cs",
  //   "setup": "app-started",                  // the setup it starts from
  //   "fresh": false,                          // true when the case changes state the cases after it rely on
  //   "checks": ["screen: the main window shows its start page"]   // what passing proves; screen checks and other checks apart
  // }
  "cases": []
}
