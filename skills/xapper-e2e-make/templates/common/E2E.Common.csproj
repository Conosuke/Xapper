<Project Sdk="Microsoft.NET.Sdk">

  <!-- Shared by every case file in the e2e folder through `#:project common/E2E.Common.csproj`.
       net10.0 on purpose: the case files and run-all.cs are .NET 10 file-based apps (#:project, #:package),
       so this must not be lowered to match an older target the rest of the repository may use. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="1.2.0" />
  </ItemGroup>

</Project>
