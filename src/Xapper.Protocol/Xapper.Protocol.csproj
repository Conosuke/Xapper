<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework />
    <!-- net462 는 .NET Framework 4.x 앱에 주입되는 Inspector 용이다. 4.x 는 같은 CLR 4 위에서 제자리 업그레이드되므로
         빌드 하나가 4.0~4.8.1 앱을 모두 덮는다. -->
    <TargetFrameworks>net462;net6.0-windows;net7.0-windows;net8.0-windows;net9.0-windows</TargetFrameworks>
  </PropertyGroup>

  <!-- 오래된 TFM 에서 C# 12 (required, init, 인덱스·범위) 를 쓰기 위한 컴파일러 폴리필. 소스로만 생성되어 런타임 의존성이 없다. -->
  <ItemGroup>
    <PackageReference Include="PolySharp" Version="1.15.0" PrivateAssets="all" />
  </ItemGroup>

  <!-- .NET Framework 에는 System.Text.Json 이 내장돼 있지 않다. 개발자 팩 없이도 빌드되도록 참조 어셈블리를 패키지로 받는다. -->
  <ItemGroup Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework'">
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
