# Copy this file to e2e.env (which is not committed) and fill in this machine's values.
# One NAME=value per line; lines starting with # are comments. ${E2E} stands for this folder.
# A variable that is already set in the environment wins over this file, so CI can pass real
# environment variables and need no e2e.env at all.

# The app under test.
APP_EXE=${E2E}\..\<path to the built app>.exe

# The Xapper MCP server executable.
XAPPER_MCP=<path to>\Xapper.McpServer.exe

# Every other server a case connects to with x.Connect("NAME"), for example the app's own MCP server.
# APP_MCP=<path to the app's MCP server>.exe
